# ===========================================
# AI YouTube Automation Platform — Environment
# ===========================================
# Copy this file to .env and fill in your keys.
# Never commit .env to version control.

# Google Gemini API Keys (get from https://aistudio.google.com/app/apikey)
# Two keys are used for automatic rotation when quota is exhausted
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here

# Pexels API Key (get from https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_api_key_here

# ElevenLabs API Key (get from https://elevenlabs.io/)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Pixabay API Key (get from https://pixabay.com/api/docs/)
PIXABAY_API_KEY=your_pixabay_api_key_here

# n8n Webhook URL (default for local n8n)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/youtube-automation

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# MongoDB Atlas URI (optional)
MONGODB_URI=your_mongodb_uri_here

# Streamlit App URL (optional - for Clerk redirect in production)
STREAMLIT_APP_URL=http://localhost:8501
